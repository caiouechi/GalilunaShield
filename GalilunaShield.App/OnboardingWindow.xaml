<Window x:Class="GalilunaShield.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Galiluna Shield" Height="620" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Icon="Assets/galiluna.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="150">
            <Border.Background>
                <ImageBrush ImageSource="Assets/hero.jpg" Stretch="UniformToFill" />
            </Border.Background>
            <Border Background="#99141A34">
                <StackPanel VerticalAlignment="Center" Margin="28,0">
                    <TextBlock Text="Let's set up Galiluna Shield" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Two quick questions and you're protected. You can change anything later." Foreground="#D6DcF5" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <StackPanel Grid.Row="1" Margin="28,22,28,0">
            <TextBlock Text="1. How old is the child on this computer?" Style="{StaticResource H2}" Margin="0,0,0,10" />
            <ItemsControl x:Name="AgeList">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock Text="2. Set a parent PIN (recommended)" Style="{StaticResource H2}" Margin="0,20,0,6" />
            <TextBlock Style="{StaticResource MutedText}" Text="Stops your child turning the shield off or changing settings, and secures the dashboard. 4 to 8 digits, or leave empty to skip." TextWrapping="Wrap" />
            <TextBox x:Name="PinBox" Width="160" HorizontalAlignment="Left" Margin="0,8,0,0" MaxLength="8" />

            <Border Background="{StaticResource BrandLight}" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                <TextBlock x:Name="ProfileSummary" TextWrapping="Wrap" Text="Pick an age to see the recommended protection." />
            </Border>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <TextBlock Text="You can fine-tune everything in Settings afterwards." Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Skip" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Skip_Click" />
                    <Button x:Name="FinishButton" Content="Finish setup" Click="Finish_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
