<Window x:Class="GalilunaShield.App.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parent PIN" Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Prompt" Text="Enter the parent PIN." FontSize="15" Margin="0,0,0,12" />
        <PasswordBox x:Name="Pin" MaxLength="8" FontSize="22" Padding="10,8" HorizontalContentAlignment="Center" KeyDown="Pin_KeyDown" />
        <TextBlock x:Name="Error" Foreground="{StaticResource Critical}" Margin="0,8,0,0" Visibility="Collapsed" Text="Wrong PIN. Try again." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
            <Button Content="Unlock" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
