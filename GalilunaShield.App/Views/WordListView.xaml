<UserControl x:Class="GalilunaShield.App.Views.WordListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Red-flag words" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource MutedText}">
                    One word or phrase per line, grouped under [Category | severity] headers. Lines starting with # are notes.
                    Add * to the end of a word to match any ending (kill* = kill, killed, killing). Critical categories start proof recording immediately.
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                <Button Content="Reload from disk" Style="{StaticResource SecondaryButton}" Command="{Binding ReloadCommand}" Margin="0,0,8,0" />
                <Button Content="Open in Notepad" Style="{StaticResource SecondaryButton}" Command="{Binding OpenInNotepadCommand}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="4">
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                     BorderThickness="0" Padding="10" VerticalContentAlignment="Top" SpellCheck.IsEnabled="False">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ok}" FontSize="13" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
