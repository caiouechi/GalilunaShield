<UserControl x:Class="GalilunaShield.App.Views.TranscriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GalilunaShield.App">
    <UserControl.Resources>
        <local:TimeConverter x:Key="Time" />
        <local:PercentConverter x:Key="Percent" />
        <local:ZeroToVisibilityConverter x:Key="Zero" />
    </UserControl.Resources>
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Live transcript" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource MutedText}" Text="Everything understood since the app started, newest first. Grey lines are ones the recognizer was unsure about; their audio is kept in the 'unclear' folder. Daily transcripts are saved as text files in the output folder." />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="16,12">
            <Grid>
                <TextBlock Text="Nothing transcribed yet. Start monitoring and say something." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Transcript.Count, Converter={StaticResource Zero}}" />
                <ListBox ItemsSource="{Binding Transcript}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding At, Converter={StaticResource Time}}" Style="{StaticResource Mono}" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource Mono}" Foreground="{StaticResource Muted}" Margin="0,2,8,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Unclear}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="3" Text="{Binding Confidence, Converter={StaticResource Percent}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
