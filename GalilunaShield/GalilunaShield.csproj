<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- Windows 10 2004+ APIs (process loopback) are guarded at runtime with OperatingSystem.IsWindowsVersionAtLeast; the WinRT projection assembly (54 MB) is not needed. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>galiluna</AssemblyName>
    <RootNamespace>GalilunaShield</RootNamespace>
    <Description>Galiluna Shield command-line engine.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GalilunaShield.Core\GalilunaShield.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
