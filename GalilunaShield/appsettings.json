{
  // ---------------------------------------------------------------------------------------------
  //  Galiluna Shield settings. This copy lives in %APPDATA%\Galiluna Shield and is safe to edit.
  //  Lines starting with // are comments.
  // ---------------------------------------------------------------------------------------------

  // Global start/stop combo (works from any window). Avoid plain Ctrl+S: a global hotkey steals it from every program.
  "Hotkey": "Ctrl+Alt+S",

  // Start monitoring as soon as the app opens (the desktop app also has a switch for this).
  "StartMonitoringOnLaunch": false,

  // Desktop app: when started with Windows, run completely hidden (no window, no tray icon). Bring it back
  // with the show-window hotkey below, or by launching the app again.
  "StartHidden": false,
  "ShowWindowHotkey": "Ctrl+Alt+G",

  // Optional PIN (4-8 digits) the desktop app asks for before stopping monitoring or changing settings.
  "ParentPin": "",

  // What to listen to:
  //   "Microphone"  - only what is said into the mic (the child speaking). Default.
  //   "SystemAudio" - only what the computer plays, filtered to calls and games (browsers/media players skipped).
  //   "Both"        - microphone + filtered system audio.
  // Override at launch with:  --mode microphone | system | both
  "Mode": "Microphone",

  // Microphone handling. By default every input device is opened and the one that actually has sound is used,
  // because the child may be talking into a headset that is not the Windows default device. Set DeviceName
  // (part of the name, e.g. "Headset") to force one device.
  "Microphone": {
    "AutoSelectDevice": true,
    "DeviceName": "",
    "SwitchAfterSilentSeconds": 5.0,
    "RescanSeconds": 5.0
  },

  "SystemAudio": {
    // Programs whose sound is never transcribed (videos, music). Process names without .exe.
    "IgnoreProcesses": [
      "chrome", "msedge", "msedgewebview2", "firefox", "brave", "opera", "opera_gx", "vivaldi", "arc", "iexplore",
      "vlc", "wmplayer", "Video.UI", "Music.UI", "Microsoft.Media.Player", "Spotify", "mpc-hc", "mpc-hc64",
      "PotPlayerMini64", "PotPlayer64", "Netflix", "AppleMusic", "AppleTV", "Amazon Music", "iTunes",
      "PrimeVideo", "Disney+", "Hulu", "Plex", "Plex HTPC", "Kodi", "MediaMonkey", "foobar2000", "AIMP", "Winamp",
      "Movies & TV", "Photos", "ZuneVideo", "ZuneMusic"
    ],
    // If non-empty, ONLY these programs are transcribed, e.g. ["Discord", "RobloxPlayerBeta", "javaw", "FortniteClient-Win64-Shipping"].
    "FocusProcesses": [],
    "RescanSeconds": 2.0,
    "FallbackToWholeSystemAudio": true
  },

  // Raw audio recording (separate from the short clips saved with each alert).
  //   "Off"         - never record.
  //   "Microphone"  - record the microphone continuously.
  //   "SystemAudio" - record system audio (same filtered programs as listening) continuously.
  //   "Both"        - record everything being listened to, continuously.
  //   "Smart"       - record nothing until SmartTriggerAlerts red flags happen within SmartTriggerWindowMinutes
  //                   (or one CRITICAL flag, if SmartTriggerOnCritical); then record everything being listened to,
  //                   including the last PreRollSeconds before the trigger, until SmartRecordMinutes pass with no
  //                   new flags. Proof without recording all day.
  // Override at launch with:  --record off | microphone | system | both | smart
  "Recording": {
    "Mode": "Smart",
    "SmartTriggerAlerts": 3,
    "SmartTriggerWindowMinutes": 5,
    "SmartTriggerOnCritical": true,
    // Calm-down margin: keep recording until this many minutes pass with no new red flag.
    "SmartRecordMinutes": 15,
    "PreRollSeconds": 60,
    // Split recordings into files of at most this many minutes.
    "MaxFileMinutes": 30
  },

  // Automatic clean-up of saved audio, so long-running installs do not fill the disk. Off by default because
  // deleting is permanent. KeepTextRecord leaves the written record (alert text, transcripts, reports) in place.
  "Retention": {
    "Enabled": false,
    "Days": 30,
    "IncludeRecordings": true,
    "IncludeScreenshots": true,
    "KeepTextRecord": true
  },

  // A picture of every monitor, captured when a red flag is detected, so you see what was on screen.
  // MinSeverity: Low | Medium | High | Critical (Low = every flag; higher = fewer screenshots, less disk).
  "Screenshots": {
    "Enabled": true,
    "MinSeverity": "Medium",
    "MinSecondsBetween": 15,
    "JpegQuality": 80
  },

  // Warn when a voice that sounds like an adult talks to the child. Judged by pitch, not identity.
  "VoiceAnalysis": {
    "Enabled": true,
    "AdultPitchHz": 165,
    "MinVoicedSeconds": 1.0,
    "FlagOnSystemAudio": true,
    "FlagOnMicrophone": false,
    "CooldownMinutes": 10
  },

  // "Cursing a lot": raise an extra alert when many flags of one category pile up in a short window.
  "Bursts": [
    { "Category": "Profanity", "Count": 5, "WindowMinutes": 10, "Severity": "High", "Label": "Heavy cursing" }
  ],

  // Optional topic packs switched on (file names from the buckets folder), e.g. ["gambling", "religion-islam"].
  "EnabledBuckets": [],

  // Encrypt audio clips, recordings and screenshots at rest (Windows DPAPI, this account; stronger with a PIN).
  // When on, reports link to the app to open media instead of embedding it.
  "Security": {
    "EncryptEvidence": false
  },

  // Alerts to the parent's phone/email when away. All sent from this computer; no server of ours.
  //   MinSeverity: Low | Medium | High | Critical.
  //   Email: any SMTP (e.g. Gmail with an app password). Webhook Type: ntfy | telegram | slack | discord | generic.
  //   ntfy is easiest: install the free ntfy app, pick a secret topic, set Url to https://ntfy.sh/that-topic.
  "Notifications": {
    "Enabled": false,
    "MinSeverity": "High",
    "MinMinutesBetween": 2,
    "IncludeText": true,
    "Email": { "Enabled": false, "SmtpHost": "", "SmtpPort": 587, "UseSsl": true, "Username": "", "Password": "", "From": "", "To": "" },
    "Webhook": { "Enabled": false, "Type": "ntfy", "Url": "", "BotToken": "", "ChatId": "" }
  },

  // Local parent dashboard (a private web page served from this PC; open it from your phone on the home wifi).
  "Web": {
    "Enabled": false,
    "Port": 8787
  },

  // HTML/CSV reports in the "reports" folder, rebuilt after each alert and when monitoring stops.
  "Reports": {
    "AutoGenerate": true,
    "WriteCsv": true
  },

  // How much CPU the recognizer may use: Light (old/slow PCs), Balanced (default), Accurate (fast PC), Custom.
  // Light/Balanced/Accurate set ModelSize, BeamSize and Threads for you; Custom honours the values below.
  "Performance": "Balanced",
  // Speech recognition. ModelSize: tiny | base | small | medium | large (bigger = more accurate, slower).
  // BeamSize: 1 = fastest, 3-5 = fewer mis-hearings at the cost of CPU. Threads: 0 = automatic.
  "ModelSize": "base",
  "Language": "auto",
  "BeamSize": 3,
  "Threads": 0,

  // Where alerts, transcripts, recordings and reports go. Relative = inside your Documents folder.
  "OutputDirectory": "Galiluna Shield",
  // Where the activity/event log (start, stop, shutdown, tamper) is saved. Empty = alongside the output
  // folder above. Otherwise a folder path (relative to Documents, or an absolute path like D:\GalilunaLogs).
  "LogsDirectory": "",
  "ContextSegments": 4,
  "SaveAudioClipOnAlert": true,
  "MinChunkSeconds": 3.0,
  "MaxChunkSeconds": 10.0,
  "SilenceSeconds": 0.7,
  // Loudness below which audio counts as silence. Lower = picks up quieter / farther-away speech (and more noise).
  "SilenceThreshold": 0.005,

  // Transcription is never 100%. FuzzyMatching also flags near mis-hearings ("kill my sale" ~ "kill myself")
  // as POSSIBLE matches. FuzzyTolerance is the fraction of letters allowed to differ (0.2 = 1 in 5).
  "FuzzyMatching": true,
  "FuzzyTolerance": 0.2,

  // Speech the recognizer was unsure about (confidence below the threshold), or speech-like sound where it
  // could not make out any words at all (mumbling, shouting, another language), is marked "unclear" in the
  // transcript and its audio is saved to the "unclear" folder so you can listen to what was really said.
  // Clear speech usually scores 80%+; garbled transcriptions score around 60-70%.
  "LowConfidenceThreshold": 0.7,
  "SaveUnclearClips": true,
  "MaxUnclearClipsPerHour": 40
}
